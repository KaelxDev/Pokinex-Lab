{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/services/websocket/protocol.js",
    "src/services/websocket/deliveryTracker.js",
    "src/types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
