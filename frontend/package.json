{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --experimental-strip-types --test test/*.test.js",
    "test:react": "vitest run --config ./vitest.config.js",
    "test:e2e": "playwright test --config ./playwright.config.js",
    "typecheck": "tsc --noEmit -p ./jsconfig.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "30.0.1",
    "oxlint": "^1.81.0",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "5.0.0"
  }
}
